-s dir
--name clash
--category net
--license GPL-3.0-or-later
--description "The universal proxy platform."
--url "https://wiki.metacubex.one/"
--maintainer "MetaCubeX <none@example.com>"
--deb-field "Bug: https://github.com/MetaCubeX/clash/issues"
--no-deb-generate-changes
--config-files /etc/clash/config.yaml

.github/release/config.yaml=/etc/clash/config.yaml

.github/release/clash.service=/usr/lib/systemd/system/clash.service
.github/release/clash@.service=/usr/lib/systemd/system/clash@.service


LICENSE=/usr/share/licenses/clash/LICENSE